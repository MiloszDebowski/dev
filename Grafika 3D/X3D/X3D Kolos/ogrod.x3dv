DEF Sciezka Transform {
    translation 0 0.51 0
    children[
        
        LampaParkowa{position -2.5 0 0 lightColor 1 0.8 0.4}
        LampaParkowa{position 2.5 0 0 lightColor 1 0.8 0.4}

        LampaParkowa{position -2.5 0 3 lightColor 1 0.8 0.4}
        LampaParkowa{position 2.5 0 3 lightColor 1 0.8 0.4}

        LampaParkowa{position -2.5 0 6 lightColor 1 0.8 0.4}
        LampaParkowa{position 2.5 0 6 lightColor 1 0.8 0.4}

        LampaParkowa{position -5 0 -3 lightColor 1 0.8 0.4}
        LampaParkowa{position 5 0 -3 lightColor 1 0.8 0.4}
        
    DEF SciezkaSciezka Shape {
        appearance Appearance {
            material DEF KolorSciezki Material {
                diffuseColor 0.55 0.27 0.07
            }
        }
        geometry Box {
            size 4 0.1 20
        }
    }
        Transform{
            translation 0 0.51 0
            children[
        DEF Trap ProximitySensor {
                    size 4 4 20
                }
            ]
        }

        DEF SciezkaColorChangeTime TimeSensor {
            cycleInterval 0.1
            loop FALSE
        }

        DEF ChangeColor ColorInterpolator {
            keyValue [0.55 0.27 0.07, 1 0 0]
            key [0,1]
        }

        Transform {
            translation 0 1 5
            children [
                DEF BoxTouch TouchSensor {}
                DEF BoxRotTransform Transform {
                    children [
                        Shape {
                            appearance Appearance { material Material { diffuseColor 1 0 1 } texture ImageTexture { url ["tekstury/mysteryBox.png"] } }
                            geometry Box { size 0.5 0.5 0.5 }
                        }
                    ]
                }
            ]
        }
        DEF BoxTimer TimeSensor { cycleInterval 2 loop FALSE }
        DEF BoxRotator OrientationInterpolator {
            key [ 0 0.5 1 ]
            keyValue [ 0 1 0 0, 0 1 0 3.14, 0 1 0 6.28 ]
        }

    ]
}

