PROTO Sosna [
    exposedField SFColor goraDrzewaKolor 0.0 1.0 0.0
    exposedField SFColor pienDrzewaKolor 0.3 0.3 0.0
] {
    Transform {
        children [
            Transform {
                translation 0 0 0
                translation 0 1 0
                children [
                    Shape {
                        geometry Cone {
                            bottomRadius 2.0
                            height 2.0
                            bottom TRUE
                            side TRUE
                            solid TRUE
                        }
                        appearance Appearance {
                            material Material {
                                diffuseColor IS goraDrzewaKolor
                            }
                        }
                    }
                ]
            }

            Transform {
                translation 0 2 0
                children [
                    Shape {
                        geometry Cone {
                            bottomRadius 1.5
                            height 2.0
                            bottom TRUE
                            side TRUE
                            solid TRUE
                        }
                        appearance Appearance {
                            material Material {
                                diffuseColor IS goraDrzewaKolor
                            }
                        }
                    }
                ]
            }

            Transform {
                translation 0 3 0
                children [
                    Shape {
                        geometry Cone {
                            bottomRadius 1.0
                            height 2.0
                            bottom TRUE
                            side TRUE
                            solid TRUE
                        }
                        appearance Appearance {
                            material Material {
                                diffuseColor IS goraDrzewaKolor
                            }
                        }
                    }
                ]
            }

            Transform{
                children[
                    Shape{
                        geometry Cylinder {
                            bottom TRUE
                            height 2
                            radius 0.2
                            side TRUE
                            solid TRUE
                            top TRUE
                        }

                        appearance Appearance{
                            material Material{
                                diffuseColor IS pienDrzewaKolor
                            }
                        }
                    }
                ]
            }

        ]
    }
}


PROTO Jablon [] {
    Transform {
        children [
            #Pień
            Transform {
                translation 0 1 0
                children [
                    Shape {
                        geometry Cylinder { radius 0.3 height 2.0 }
                        appearance Appearance {
                            material Material { diffuseColor 0.4 0.2 0.0 } # Brązowy
                        }
                    }
                ]
            }
            #Korona
            Transform {
                translation 0 2.5 0
                children [
                    Shape {
                        geometry Sphere { radius 1.5 }
                        appearance Appearance {
                            material Material { diffuseColor 0.0 0.8 0.0 } # Zielony
                        }
                    }
                ]
            }
            #Jabłko1
            Transform {
                translation 0.8 2.5 0.8
                children [
                    Shape {
                        geometry Sphere { radius 0.2 }
                        appearance Appearance { material Material { diffuseColor 1.0 0.0 0.0 } }
                    }
                ]
            }
            #Jabłko 2
            Transform {
                translation -0.7 3.0 0.5
                children [
                    Shape {
                        geometry Sphere { radius 0.2 }
                        appearance Appearance { material Material { diffuseColor 1.0 0.0 0.0 } }
                    }
                ]
            }
            #Jabłko3
            Transform {
                translation 0.2 2.2 -1.0
                children [
                    Shape {
                        geometry Sphere { radius 0.2 }
                        appearance Appearance { material Material { diffuseColor 1.0 0.0 0.0 } }
                    }
                ]
            }
        ]
    }
}



PROTO MyBillboard [
  exposedField MFString adTexture []
  exposedField SFVec3f translation 0 0 0
  exposedField SFRotation rotation 0 1 0 0
] {
  Transform {
    translation IS translation
    rotation IS rotation
    children [
      Transform {
        translation 0 2 0
        children [
          Shape {
            appearance Appearance {
              material Material {
                diffuseColor 0.42 0.47 0.52
                specularColor 0.8 0.8 0.9
                shininess 0.4
              }
            }
            geometry Cylinder { height 6 radius 0.3 }
          }
        ]
      }

      Transform {
        translation 0 5.5 0.52
        children [
          Shape {
            appearance Appearance {
              material Material {
                diffuseColor 0.08 0.12 0.13
                specularColor 0.28 0.36 0.36
                shininess 0.2
              }
            }
            geometry Box { size 6.2 2.8 0.16 }
          }

          Transform {
            translation 0 0 0.05  
            children [
              Shape {
                appearance Appearance {
                  material Material {
                    diffuseColor 1.0 1.0 1.0
                    ambientIntensity 0.8
                  }
                  texture ImageTexture { url IS adTexture }
                }
                geometry Box { size 6.0 2.6 0.08 }
              }
            ]
          }
        ]
      }

      Transform {
        translation 0 4.2 0.55
        children [
