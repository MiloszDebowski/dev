PROTO LampaParkowa [
    field SFVec3f position 0 0 0
    field SFColor lightColor 1 0.6 0.2
]
{
    Transform {
        translation IS position
        children [
            DEF TS_Parkowa TouchSensor {}

            DEF TOGGLE_Parkowa BooleanToggle { 
                toggle TRUE 
            }

            DEF LIGHT_Parkowa SpotLight {
                location 0 3.2 0
                direction 0 -1 0
                cutOffAngle 1.4
                beamWidth 0.9
                radius 10
                intensity 5.0
                color IS lightColor
                attenuation 0 0.5 0
                on TRUE
            }

            Group {
                children [
                    Transform {
                        translation 0 0.5 0
                        children [
                            Shape {
                                appearance Appearance { material Material { diffuseColor 0.2 0.1 0.0 } }
                                geometry Cone { bottomRadius 0.4 height 1.0 }
                            }
                        ]
                    }
                    Transform {
                        translation 0 2.0 0
                        children [
                            Shape {
                                appearance Appearance { material Material { diffuseColor 0.2 0.1 0.0 } }
                                geometry Cylinder { height 3.0 radius 0.08 }
                            }
                        ]
                    }
                    Transform {
                        translation 0 3.5 0
                        children [
                            Shape {
                                appearance Appearance { material Material { diffuseColor 1 0.8 0.4 transparency 0 emissiveColor 1 1 1} }
                                geometry Cylinder { height 0.6 radius 0.25 }
                            }
                        ]
                    }
                    Transform {
                        translation 0 3.9 0
                        children [
                            Shape {
                                appearance Appearance { material Material { diffuseColor 0.1 0.1 0.1 } }
                                geometry Cone { bottomRadius 0.5 height 0.3 }
                            }
                        ]
                    }
                ]
            }
        ]
    }
    ROUTE TS_Parkowa.isActive TO TOGGLE_Parkowa.set_boolean
    ROUTE TOGGLE_Parkowa.toggle_changed TO LIGHT_Parkowa.on
}

