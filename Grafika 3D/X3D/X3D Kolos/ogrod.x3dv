ROUTE Trap.enterTime TO SciezkaColorChangeTime.startTime
ROUTE SciezkaColorChangeTime.fraction_changed TO ChangeColor.set_fraction
ROUTE ChangeColor.value_changed TO KolorSciezki.diffuseColor
ROUTE BoxTouch.touchTime TO BoxTimer.startTime
