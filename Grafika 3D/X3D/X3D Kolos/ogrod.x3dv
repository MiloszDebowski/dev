            translation 0 -0.14 -0.24
            rotation 1 0 0 0.85
            children [
              Shape {
                appearance Appearance { material Material { diffuseColor 0.6 0.6 0.6 specularColor 0.85 0.85 0.9 shininess 0.7 } }
                geometry Cylinder { radius 0.04 height 0.38 }
              }
            ]
          }
          Shape {
            appearance Appearance { material Material { diffuseColor 0.8 0.8 0.76 } }
            geometry Box { size 0.17 0.18 0.16 }
          }
          SpotLight {
            location 0 0 0
            direction 0 -2 -0.4
            color 1 1 0.9
            intensity 1.2
            beamWidth 0.6
            cutOffAngle 0.8
            radius 8
          }
        ]
      }

      Transform {
        translation 1.8 7.0 0.6
        rotation 1 0 0 -0.65
        children [
          Transform {
            translation 0 -0.14 -0.24
            rotation 1 0 0 0.85
            children [
              Shape {
                appearance Appearance { material Material { diffuseColor 0.6 0.6 0.6 specularColor 0.85 0.85 0.9 shininess 0.7 } }
                geometry Cylinder { radius 0.04 height 0.38 }
