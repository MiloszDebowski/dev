#X3D V3.3 utf8
PROFILE Immersive

PROTO MyBillboard [
  exposedField MFString adTexture []
  exposedField SFVec3f translation 0 0 0
  exposedField SFRotation rotation 0 1 0 0
] {
  Transform {
    translation IS translation
    rotation IS rotation
    children [
      #Słup billboardu
      Transform {
        translation 0 2 0
        children [
          Shape {
            appearance Appearance {
              material Material {
                diffuseColor 0.42 0.47 0.52
                specularColor 0.8 0.8 0.9
                shininess 0.4
              }
            }
            geometry Cylinder { height 6 radius 0.3 }
          }
        ]
      }

      #Głowica
      Transform {
        translation 0 5.5 0.52
        children [
          # Rama billboardu
          Shape {
            appearance Appearance {
              material Material {
                diffuseColor 0.08 0.12 0.13
                specularColor 0.28 0.36 0.36
                shininess 0.2
              }
            }
            geometry Box { size 6.2 2.8 0.16 }
          }

          Transform {
            translation 0 0 0.05  
            children [
              Shape {
                appearance Appearance {
                  material Material {
                    diffuseColor 1.0 1.0 1.0
                    ambientIntensity 0.8
                  }
                  texture ImageTexture { url IS adTexture }
                }
                geometry Box { size 6.0 2.6 0.08 }
              }
            ]
          }
        ]
      }

      #Rampy robocze
      Transform {
        translation 0 4.2 0.55
        children [
          Shape {
            appearance Appearance { material Material { diffuseColor 0.23 0.24 0.26 } }
            geometry Box { size 6.6 0.18 1.3 }
          }
          # Balustrady boczne
          Transform {
            translation -3.1 0.19 0
            children [
              Shape {
                appearance Appearance { material Material { diffuseColor 0.18 0.18 0.21 } }
                geometry Box { size 0.08 0.6 1.3 }
              }
            ]
          }
          Transform {
            translation 3.1 0.19 0
            children [
              Shape {
                appearance Appearance { material Material { diffuseColor 0.18 0.18 0.21 } }
                geometry Box { size 0.08 0.6 1.3 }
              }
            ]
          }
          # Balustrady przednie
          Transform {
            translation 0 0.19 0.61
            children [
              Shape {
                appearance Appearance { material Material { diffuseColor 0.18 0.18 0.21 } }
                geometry Box { size 6.6 0.12 0.06 }
              }
            ]
          }
        ]
      }

      #Oświetlenie
      Transform {
        translation -1.8 7.0 0.6
        rotation 1 0 0 -0.65
        children [
          #Uchwyt lampki
          Transform {
            translation 0 -0.14 -0.24
            rotation 1 0 0 0.85
            children [
              Shape {
                appearance Appearance { material Material { diffuseColor 0.6 0.6 0.6 specularColor 0.85 0.85 0.9 shininess 0.7 } }
                geometry Cylinder { radius 0.04 height 0.38 }
              }
            ]
          }
          #Klosz
          Shape {
            appearance Appearance { material Material { diffuseColor 0.8 0.8 0.76 } }
            geometry Box { size 0.17 0.18 0.16 }
          }
          #SpotLight
          SpotLight {
            location 0 0 0
            direction 0 -2 -0.4
            color 1 1 0.9
            intensity 1.2
            beamWidth 0.6
            cutOffAngle 0.8
            radius 8
          }
        ]
      }

      #Oświetlenie
      Transform {
        translation 1.8 7.0 0.6
        rotation 1 0 0 -0.65
        children [
          #Uchwyt
          Transform {
            translation 0 -0.14 -0.24
            rotation 1 0 0 0.85
            children [
              Shape {
                appearance Appearance { material Material { diffuseColor 0.6 0.6 0.6 specularColor 0.85 0.85 0.9 shininess 0.7 } }
                geometry Cylinder { radius 0.04 height 0.38 }
              }
            ]
          }
          #Klosz
          Shape {
            appearance Appearance { material Material { diffuseColor 0.8 0.8 0.76 } }
            geometry Box { size 0.17 0.18 0.16 }
          }
          #SpotLight
          SpotLight {
            location 0 0 0
            direction 0 -2 -0.4
            color 1 1 0.9
            intensity 1.2
            beamWidth 0.6
            cutOffAngle 0.8
            radius 8
          }
        ]
      }
    ]
  }
}

Group {
  children [
    Background { skyColor [ 0.07 0.11 0.19 ] }

    DirectionalLight {
      direction 0 -1 -0.7
      color 0.7 0.7 1
      intensity 0.3
      ambientIntensity 0.8
    }

    Transform {
      scale 0.5 0.5 0.5
      children [
        MyBillboard {
          translation 0 0 0
          rotation 0 1 0 0
          adTexture [ "tekstury/kasztelan.jpg" ]
        }
      ]
    }

    Viewpoint {
      description "Widok na billboard"
      position 0 7 14
      orientation 0 1 0 0
    }
  ]
}

