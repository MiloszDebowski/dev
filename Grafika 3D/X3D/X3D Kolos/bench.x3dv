#X3D V3.3 utf8

PROTO ParkBench [
  field SFVec3f position 0 0 0
  field SFRotation orientation -1 0 0 1.57
] {
  Transform {
    
    translation IS position
    rotation IS orientation
    children [
      # Siedzisko ławki
      Transform {
        translation 0 0 0.45
        children [
          Shape {
            appearance Appearance {
              material Material {
                diffuseColor 0.6 0.4 0.1
              }
            }
            geometry Box {
              size 2.0 0.5 0.08
            }
          }
        ]
      }
      # Oparcie ławki
      Transform {
        translation 0 0.23 0.65
        children [
          Shape {
            appearance Appearance {
              material Material {
                diffuseColor 0.7 0.5 0.2
              }
            }
            geometry Box {
              size 2.0 0.06 0.4
            }
          }
        ]
      }
      # Lewa noga
      Transform {
        translation -0.95 0 0.225
        children [
          Shape {
            appearance Appearance {
              material Material {
                diffuseColor 0.3 0.3 0.3
              }
            }
            geometry Box {
              size 0.1 0.5 0.45
            }
          }
        ]
      }
      # Prawa noga
      Transform {
        translation 0.95 0 0.225
        children [
          Shape {
            appearance Appearance {
              material Material {
                diffuseColor 0.3 0.3 0.3
              }
            }
            geometry Box {
              size 0.1 0.5 0.45
            }
          }
        ]
      }
    ]
  }
}

# Przykład użycia
ParkBench {
  position 0 0 0
}
