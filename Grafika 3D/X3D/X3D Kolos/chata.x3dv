#X3D V3.3 utf8
PROFILE Immersive

Viewpoint {
  description "Chatka - bale blisko siebie"
  position 0 2 13
}
Background { skyColor [ 0.4 0.6 0.85 ] groundColor [ 0.15 0.4 0.2 ] }
DirectionalLight { direction -0.5 -1 -0.5 intensity 0.7 }

Transform { translation 0 0 0
  children [
    # PODLOGA
    Transform { translation 0 0.2 0
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.3 0.4 0.2 } }
          geometry Box { size 7 0.3 7 }
        }
      ]
    }

    DEF LOG Shape {
      appearance Appearance {
        material Material { diffuseColor 0.45 0.30 0.15 specularColor 0.1 0.08 0.05 }
      }
      geometry Cylinder { radius 0.25 height 6 }
    }

    # SCIANA PRZOD/TYL (mniejsze odstępy bale co 0.5 jednostki)
    Group {
      children [
        Transform { translation 0 0.5 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 1.0 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 1.5 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 2.0 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 2.5 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 3.0 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 3.5 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 4.0 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 4.5 3 rotation 0 0 1 1.57 children [ USE LOG ] }

        Transform { translation 0 0.5 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 1.0 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 1.5 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 2.0 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 2.5 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 3.0 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 3.5 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 4.0 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 4.5 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
      ]
    }
    # BOKI (X = +/-3), bale co 0.5 jednostki
    Transform { rotation 0 1 0 1.57
      children [
        Transform { translation 0 0.75 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 1.25 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 1.75 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 2.25 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 2.75 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 3.25 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 3.75 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 4.25 3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 4.75 3 rotation 0 0 1 1.57 children [ USE LOG ] }

        Transform { translation 0 0.75 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 1.25 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 1.75 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 2.25 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 2.75 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 3.25 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 3.75 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 4.25 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
        Transform { translation 0 4.75 -3 rotation 0 0 1 1.57 children [ USE LOG ] }
      ]
    }

    # DACH na nowej wysokości
    Transform { translation 0 5.0 0
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.5 0.1 0.07 specularColor 0.15 0.05 0.01
            }
          }
          geometry IndexedFaceSet {
            coord Coordinate {
              point [
                -3.6 0 3.6, 3.6 0 3.6, 3.6 0 -3.6, -3.6 0 -3.6,
                0 2.7 0
              ]
            }
            coordIndex [ 0 1 4 -1, 1 2 4 -1, 2 3 4 -1, 3 0 4 -1 ]
          }
        }
        Shape {
          appearance Appearance { material Material { diffuseColor 0.3 0.08 0.04 } }
          geometry Box { size 7.2 0.18 7.2 }
        }
      ]
    }

    # KOMIN
    Transform { translation 1.3 5.95 -1.3
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.28 0.25 0.19 } }
          geometry Box { size 0.6 1.1 0.6 }
        }
      ]
    }

    # DRZWI
    Transform { translation 0 1.75 3.23
      children [
        # Rama
        Shape {
          appearance Appearance { material Material { diffuseColor 0.5 0.32 0.11 } }
          geometry Box { size 1.3 2.0 0.18 }
        }
        # Skrzydło
        Transform { translation 0 0 0.1
          children [
            Shape {
              appearance Appearance { material Material { diffuseColor 0.36 0.22 0.09 } }
              geometry Box { size 1.1 1.7 0.09 }
            }
          ]
        }
        # Próg
        Transform { translation 0 -0.95 0
          children [
            Shape {
              appearance Appearance { material Material { diffuseColor 0.42 0.29 0.13 } }
              geometry Box { size 1.0 0.12 0.15 }
            }
          ]
        }
        # Klamka
        Transform { translation 0.45 0 0.12
          children [
            Shape {
              appearance Appearance { material Material { diffuseColor 1 0.9 0.05 } }
              geometry Sphere { radius 0.09 }
            }
          ]
        }
      ]
    }

    # OKNO LEWE
    Transform { translation -3.23 2.5 0 rotation 0 1 0 1.57
      children [
        Shape { appearance Appearance { material Material { diffuseColor 0.8 0.78 0.5 } } geometry Box { size 1.1 1.1 0.13 } }
        Transform { translation 0 0 0.09
          children [
            Shape { appearance Appearance { material Material { diffuseColor 0.6 0.8 1 transparency 0.62 specularColor 1 1 1 } } geometry Box { size 0.95 0.95 0.07 } }
            Shape { appearance Appearance { material Material { diffuseColor 0.85 0.82 0.6 } } geometry Box { size 0.93 0.07 0.09 } }
            Shape { appearance Appearance { material Material { diffuseColor 0.85 0.82 0.6 } } geometry Box { size 0.07 0.93 0.09 } }
          ]
        }
      ]
    }

    # SCHODKI
    Transform { translation 0 0.2 3.8
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.5 0.5 0.45 } }
          geometry Box { size 1.2 0.21 0.7 }
        }
      ]
    }
  ]
}
