DEF  GhostSphere Transform{
    translation 5 0 12.25
    children[
        Shape{
            geometry Sphere {
                radius 0.5
            }

            appearance Appearance{
                material DEF MAT Material{
                    diffuseColor 1 1 0
                    transparency 1
                }
            }
        }

        DEF GhostMove PositionInterpolator {
            keyValue [5 0 12.25, -5 0 12.25 5 0 12.25]
            key [0 0.5 1]
        }

        DEF GhostMoveTime TimeSensor {
            cycleInterval 10
            loop TRUE
        }

        DEF GhostFadeTime TimeSensor{
            cycleInterval 0.5
            loop FALSE
        }

        DEF TransInter ScalarInterpolator {
            keyValue [1, 0.5]
            key [0, 1]
        }
    ]
}

ROUTE GhostMoveTime.fraction_changed TO GhostMove.set_fraction
ROUTE GhostMove.value_changed TO GhostSphere.set_translation




DEF Hint Transform{
    translation 0 0 3.8
    children[

        DEF HintTouchSensor TouchSensor{

        }

        Shape{
            geometry Box {
                size 1 0.5 0.1
            }

        appearance Appearance{
            material Material{
            }
            texture ImageTexture{
                url["wskazowka.png"]
            }
        }

        }

        DEF HintLight PointLight {
            color 1 1 1
            on FALSE
            location 0 0 -1
        }
        
    ]
}

ROUTE HintTouchSensor.isActive TO HintLight.set_on

DEF Torches Transform{
    rotation 1 0 0 -0.2
    children[
        DEF leftDoorTorch Transform{
            translation 0.6 0 -0.4
            children[
                DEF LEFTTorch Torch{}
            ]
        }

        DEF RightDoorTorch Transform{
            translation -1.6 0 -0.4
            children[
              DEF RIGHTTorch Torch{}
            ]
        }

     DEF TorchesColorTime TimeSensor{
        loop TRUE
        cycleInterval 3
     }

     DEF TorchesColorChange ColorInterpolator {
        keyValue [1 0 0, 1 0.5 0, 1 1 0, 1 0.5 0, 1 0 0]
        key [0, 0.25, 0.5, 0.75, 1]
     }

    ]
}

ROUTE TorchesColorTime.fraction_changed TO TorchesColorChange.set_fraction
ROUTE TorchesColorChange.value_changed TO RIGHTTorch.set_flameColor
ROUTE TorchesColorChange.value_changed TO LEFTTorch.set_flameColor


DEF Board Transform{

    
    translation -0.5 -2 7

    
    children[

        DEF Trap Transform{
            translation 0 2 5.25
            children[
                DEF TrapSensor ProximitySensor {
                    center 0 0 0
                    size 13 2 2
                }
            ]
        }

        DEF BottomBoard Transform{
            children[
                Shape{
                    geometry Box{
                    size 15 1.1 15
                    }

                    appearance Appearance{
                        material Material{
                            diffuseColor 0.9 0.9 0.9
                        }
                    }
                }
            ]
        }

        DEF UpperBoard Transform{
            translation 0 -1.1 0
            children[

               Shape{
                    geometry Box{
                    size 16 1.1 16
                    }

                    appearance Appearance{
                        material Material{
                            diffuseColor 0.9 0.9 0.9
                        }
                    }
                } 
            ]
        }
    ]
}


ROUTE TrapSensor.enterTime TO GhostMoveTime.set_startTime
ROUTE GhostMoveTime.fraction_changed TO GhostMove.set_fraction
ROUTE GhostMove.value_changed TO GhostSphere.set_translation
ROUTE TrapSensor.enterTime TO GhostFadeTime.set_startTime
ROUTE GhostFadeTime.fraction_changed TO TransInter.set_fraction
ROUTE TransInter.value_changed TO MAT.set_transparency


DEF LeftDoor Transform{
    center -0.5 0 0
    translation -1 0 0
    children[

               DEF LeftDoorTouch TouchSensor { }

                

        Shape{

            

            geometry Box{
                size 1 3 0.05
            }

            appearance Appearance{
                material Material{
                    diffuseColor 0.5 0.2 0.07
                }
            }
        }

        DEF DoorHandle Transform{
            rotation 1 0 0 1.57
            translation 0.2 0 0
            children[
                Shape{
                    geometry Cylinder{
                        radius 0.08
                        height 0.1
                    }

                    appearance Appearance{
                        material Material{
                            diffuseColor 1 1 0
                        }
                    }
                }
            ]
        }
    ]
}

DEF RightDoor Transform{
    translation 0 0 0
    center 0.5 0 0
    children[

        DEF RightDoorTouch TouchSensor { }

        Shape{
            geometry Box{
                size 1 3 0.05
            }

            appearance Appearance{
                material Material{
                    diffuseColor 0.5 0.2 0.07
                }
            }
        }

        DEF DoorHandle Transform{
            rotation 1 0 0 1.57
            translation -0.2 0 0
            children[
                Shape{
                    geometry Cylinder{
                        radius 0.08
                        height 0.1
                    }

                    appearance Appearance{
                        material Material{
                            diffuseColor 1 1 0
                        }
                    }
                }
            ]
        }
    ]
}

DEF DoorTime TimeSensor{
    loop FALSE
    cycleInterval 5
}

DEF LeftDoorOpen OrientationInterpolator{
    key[0, 0.5, 1]
    keyValue[0 -1 0 0, 0 -1 0 1.57, 0 -1 0 0]
}

ROUTE LeftDoorTouch.touchTime TO DoorTime.set_startTime
ROUTE DoorTime.fraction_changed TO LeftDoorOpen.set_fraction
ROUTE LeftDoorOpen.value_changed TO LeftDoor.set_rotation

DEF RightDoorOpen OrientationInterpolator{
    key[0, 0.5, 1]
    keyValue[0 1 0 0, 0 1 0 1.57, 0 1 0 0]
}

ROUTE DoorTime.fraction_changed TO RightDoorOpen.set_fraction
ROUTE RightDoorOpen.value_changed TO RightDoor.set_rotation

