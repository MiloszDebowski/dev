#X3D V3.3 utf8

PROTO Torch[
    field SFColor stickColor 0.3 0.3 0.0
    field SFColor flameColor 1.0 0 0
]{
    Transform{
        children[
            Transform{
                children[
                    DEF Stick Shape{
                        geometry Cylinder{
                            radius 0.05
                            height 1
                        }

                        
                        appearance Appearance{
                            material Material{
                                diffuseColor IS stickColor
                            }
                        }
                    }
                ]
            }

            Transform{
                translation 0 0.6 0
                children[
                    DEF Flame Shape{
                        geometry Cylinder{
                            radius 0.15
                            height 0.4
                        }

                        appearance Appearance{
                            material Material{
                                diffuseColor IS flameColor
                            }
                        }
                    }
                ]
            }
        ]
    }
}

Torch{}