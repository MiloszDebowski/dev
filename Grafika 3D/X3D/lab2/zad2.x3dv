#X3D V3.3 utf8
DEF Board Transform{
    translation -0.5 -2 7
    children[
        DEF BottomBoard Transform{
            children[
                Shape{
                    geometry Box{
                    size 15 1.1 15
                    }

                    appearance Appearance{
                        material Material{
                            diffuseColor 0.9 0.9 0.9
                        }
                    }
                }
            ]
        }

        DEF UpperBoard Transform{
            translation 0 -1.1 0
            children[
               Shape{
                    geometry Box{
                    size 16 1.1 16
                    }

                    appearance Appearance{
                        material Material{
                            diffuseColor 0.9 0.9 0.9
                        }
                    }
                } 
            ]
        }
    ]
}

DEF LeftDoor Transform{
    center -0.5 0 0
    translation -1 0 0
    children[
        Shape{
            geometry Box{
                size 1 3 0.05
            }

            appearance Appearance{
                material Material{
                    diffuseColor 0.5 0.2 0.07
                }
            }
        }

        DEF DoorHandle Transform{
            rotation 1 0 0 1.57
            translation 0.2 0 0
            children[
                Shape{
                    geometry Cylinder{
                        radius 0.08
                        height 0.1
                    }

                    appearance Appearance{
                        material Material{
                            diffuseColor 1 1 0
                        }
                    }
                }
            ]
        }
    ]
}

DEF RightDoor Transform{
    translation 0 0 0
    center 0.5 0 0
    children[
        Shape{
            geometry Box{
                size 1 3 0.05
            }

            appearance Appearance{
                material Material{
                    diffuseColor 0.5 0.2 0.07
                }
            }
        }

        DEF DoorHandle Transform{
            rotation 1 0 0 1.57
            translation -0.2 0 0
            children[
                Shape{
                    geometry Cylinder{
                        radius 0.08
                        height 0.1
                    }

                    appearance Appearance{
                        material Material{
                            diffuseColor 1 1 0
                        }
                    }
                }
            ]
        }
    ]
}

DEF DoorTime TimeSensor{
    loop TRUE
    cycleInterval 5
}

DEF LeftDoorOpen OrientationInterpolator{
    key[0, 0.5, 1]
    keyValue[0 -1 0 0, 0 -1 0 1.57, 0 -1 0 0]
}

ROUTE DoorTime.fraction_changed TO LeftDoorOpen.set_fraction
ROUTE LeftDoorOpen.value_changed TO LeftDoor.set_rotation

DEF RightDoorOpen OrientationInterpolator{
    key[0, 0.5, 1]
    keyValue[0 1 0 0, 0 1 0 1.57, 0 1 0 0]
}

ROUTE DoorTime.fraction_changed TO RightDoorOpen.set_fraction
ROUTE RightDoorOpen.value_changed TO RightDoor.set_rotation

