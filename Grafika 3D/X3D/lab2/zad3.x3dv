#SATURN
DEF SaturnOrbit Transform{
    children[
        DEF Saturn Transform {
            translation 4.3 0 0
            children[
                Shape{

                    geometry Sphere {
                        radius 0.25
                    }

                    appearance Appearance {
                        texture ImageTexture {
                            url ["tekstury_układ_słoneczny/2k_saturn.jpg"]
                        }
                    }
                }

                DEF SaturnRing Transform{
                    rotation 1 1 0 0.4
                    children[
                        Shape{

                            geometry Cylinder {
                                bottom TRUE
                                height 0.01
                                radius 0.45
                                side FALSE
                                solid TRUE
                                top TRUE
                                texCoord NULL
                                slices -1
                                stacks -1
                            }

                            appearance Appearance{
                                texture ImageTexture{
                                    url["tekstury_układ_słoneczny/2k_saturn_ring_alpha.png"]
                                }
                            }
                        }
                    ]
                }
            ]
        }
    ]
}

