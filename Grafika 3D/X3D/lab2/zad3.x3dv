#X3D V3.3 utf8

Viewpoint {
    description "Start View"
    position 3.15 0 6.6
    orientation 0 0 0 0
}

Viewpoint{
    description "Full View"
    position 0 15 0
    orientation -1 0 0 1.57
}

#SUN
DEF Sun Transform {
    children [
        Shape{
            
            geometry Sphere {}

            appearance Appearance {
                texture ImageTexture {
                    url ["tekstury_układ_słoneczny/sun.jpg"]
                }
            }
        }
    ]
}

DEF SunSpinTime TimeSensor{
    loop TRUE
    cycleInterval 30
}

DEF SunSpin OrientationInterpolator{
    keyValue[0 1 0 0, 0 1 0 1.57, 0 1 0 3.14, 0 1 0 4.71, 0 1 0 6.28]
    key[0, 0.25, 0.5, 0.75, 1]
}

ROUTE SunSpinTime.fraction_changed TO SunSpin.set_fraction
ROUTE SunSpin.value_changed TO Sun.set_rotation

#MERCURY
DEF MercuryOrbit Transform{
    children[
        DEF Mercury Transform {
            translation 1.35 0 0
            children[
